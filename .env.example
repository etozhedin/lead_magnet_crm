DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret-before-deploying
ADMIN_ORIGIN=http://admin.localhost:8017
PUBLIC_ORIGIN=http://forms.localhost:8017
TRUST_PROXY=0
POSTGRES_DB=lead_magnet_crm
POSTGRES_USER=lead_magnet_crm
POSTGRES_PASSWORD=local-development-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Local defaults remain unchanged. For hosted PostgreSQL, DATABASE_URL takes precedence.
# See deploy/render.env.example for Render + Neon configuration.
# DATABASE_URL=postgresql://ROLE:PASSWORD@DIRECT_NEON_HOST/DATABASE?sslmode=require
# SERVICE_ROLE=combined
# RUN_MIGRATIONS=0
# PORT=8017
# For local-only development without PostgreSQL: DB_ENGINE=sqlite

# Enter secrets in Render's Environment settings, not in Git.
# The Blueprint copies the shared values from admin to forms on Blueprint sync.
DEBUG=0
TRUST_PROXY=1
RUN_MIGRATIONS=1
WEB_CONCURRENCY=1
# Render sets PORT; 10000 is its default.
PORT=10000
SERVICE_ROLE=admin
SECRET_KEY=generate-a-random-secret-and-share-it-between-both-services
# Use Neon's DIRECT connection URL (disable connection pooling in Connect).
DATABASE_URL=postgresql://ROLE:PASSWORD@DIRECT_NEON_HOST/DATABASE?sslmode=require
# Replace these with the EXACT HTTPS URLs assigned by Render, including any suffix.
ADMIN_ORIGIN=https://YOUR_ADMIN_SERVICE.onrender.com
PUBLIC_ORIGIN=https://YOUR_FORMS_SERVICE.onrender.com
# Only on the admin service; remove after the initial successful deployment.
BOOTSTRAP_OPERATOR_USERNAME=choose-an-operator-username
BOOTSTRAP_OPERATOR_PASSWORD=choose-a-long-unique-password
